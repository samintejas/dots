/* Dots tokens (dark). Keep in sync with quickshell/theme/Theme.qml */
* {
  al:       #00000000;
  well:     #000000;    /* bg-well: where you type */
  overlay:  #1a1a1a;    /* bg-overlay: palette */
  hover:    #ffffff0d;  /* bg-hover: 5% white tint */
  text:     #e2e2e2;    /* text-strong: menu rows */
  strong:   #f5f5f5;    /* text-max: current item */
  secondary:#9c9c9c;    /* text-secondary: hints */
  border:   #4e4e4e;    /* border-overlay */
  control:  #383838;    /* border-raised / input */
  ring:     #ef9cd88c;  /* focus-ring: accent-primary 55% */

  pink:     #ef9cd8;
  red:      #f38ba8;

  bg:       @overlay;
  fg:       @text;
  muted:    @secondary;
  accent:   @pink;
  selected: @hover;
  inset:    @well;
}
