# Default config for imv

[options]
#
# Suppress built-in key bindings, and specify them explicitly in this
# config file.
suppress_default_binds = true
background = 0b0b0b
overlay_font = GeistMono Nerd Font:12
overlay_text_color = e2e2e2
overlay_background_color = 171717
overlay_background_alpha = ff
title_text = [$imv_current_index/$imv_file_count] $(basename "$imv_current_file")

[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# alias = command to run

[binds]
# Define some key bindings
q = quit

# Image navigation
<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming
<Up> = zoom 1
<Shift+plus> = zoom 1
i = zoom 1
<Down> = zoom -1
<minus> = zoom -1
o = zoom -1

# Rotate Clockwise by 90 degrees
<Ctrl+r> = rotate by 90

# Other commands
x = close
<Return> = fullscreen
<F11> = fullscreen
<Tab> = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1

# File actions (see ~/.local/bin/imv-act)
# Trash and favourite move the file under ~/tmp/images and show the next image
<Delete> = exec imv-act trash; close
d = exec imv-act trash; close
f = exec imv-act fav; close
u = exec imv-act undo
y = exec imv-act path
<Shift+Y> = exec imv-act copy
w = exec imv-act wall
<Shift+W> = exec imv-act keepwall
