# Ignore everything
home/*
!home/.config/
home/.config/*

# Keep specific home dotfiles
!home/.zshrc

# Claude Code: track only hand-written config (settings, skills, agents, commands).
# Sessions, history, credentials, plugins and synced skills stay in ~/.claude, unlinked.
!home/.claude/
home/.claude/*
!home/.claude/settings.json
!home/.claude/CLAUDE.md
!home/.claude/keybindings.json
!home/.claude/skills/
!home/.claude/agents/
!home/.claude/commands/
home/.claude/skills/synced/

# Backups and leftovers never belong in the repo
*.bak
*.pre-stow-backup

# Keep specific configs
!home/.config/hypr/
!home/.config/nvim/
!home/.config/quickshell/
!home/.config/gtk-3.0/
!home/.config/gtk-4.0/
!home/.config/ghostty/
!home/.config/yazi/
!home/.config/imv/
!home/.config/mindmirror/

# -----------------------------------------------------------------------------
# Explicit excludes — app state, caches, credentials and generated config.
# Listed last so they win over any whitelist rule above.
# -----------------------------------------------------------------------------
home/.config/btop/
home/.config/bruno/
home/.config/caveman/
home/.config/composer/
home/.config/create-next-app-nodejs/
home/.config/dconf/
home/.config/Element/
home/.config/figma-linux/
home/.config/git/
home/.config/github-copilot/
home/.config/go/
home/.config/google*/
home/.config/helix/
home/.config/herdr/
home/.config/JetBrains/
home/.config/nextjs-nodejs/
home/.config/opencode/
home/.config/pritunl/
home/.config/pulse/
home/.config/qBittorrent/
home/.config/rclone/
home/.config/slack/
home/.config/snyk/
home/.config/spotify/
home/.config/stripe/
home/.config/systemd/
home/.config/transmission*/
home/.config/turborepo/
home/.config/xdg-desktop-portal/
home/.config/xsett*/
home/.config/zen/
home/.config/mimeapps.list

# Editor/tooling backup droppings
*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]

# lazy.nvim lockfile — plugin versions resolve per-machine
home/.config/nvim/lazy-lock.json
